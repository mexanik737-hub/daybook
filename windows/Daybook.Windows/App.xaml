<Application x:Class="Daybook.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#111318" />
        <SolidColorBrush x:Key="PanelBackground" Color="#1B1E25" />
        <SolidColorBrush x:Key="PrimaryText" Color="#F2F3F5" />
        <SolidColorBrush x:Key="MutedText" Color="#9CA3AF" />
        <SolidColorBrush x:Key="Accent" Color="#A78BFA" />
    </Application.Resources>
</Application>
