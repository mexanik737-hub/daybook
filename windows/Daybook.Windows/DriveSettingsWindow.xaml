<Window x:Class="Daybook.Windows.DriveSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Google Drive — Daybook" Height="390" Width="560" MinHeight="360" MinWidth="500"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBackground}" Foreground="{StaticResource PrimaryText}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="СИНХРОНИЗАЦИЯ" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="SemiBold"/>
            <TextBlock Text="Google Drive" FontSize="28" FontWeight="SemiBold" Margin="0,6,0,12"/>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="Для Windows нужен OAuth Client ID типа Desktop app из Google Cloud Console."
                   TextWrapping="Wrap" Foreground="{StaticResource MutedText}" Margin="0,0,0,16"/>
        <StackPanel Grid.Row="2">
            <TextBlock Text="Desktop OAuth Client ID" Margin="0,0,0,6"/>
            <TextBox x:Name="ClientIdBox" Height="40" Padding="10,8" FontSize="13"
                     Background="{StaticResource PanelBackground}" Foreground="{StaticResource PrimaryText}"
                     BorderBrush="#343A46" VerticalContentAlignment="Center"/>
        </StackPanel>
        <TextBlock Grid.Row="3" Text="Client ID не является секретом. Не вставляй сюда Client Secret. Токены обновления будут храниться локально в защищённом Windows DPAPI-хранилище."
                   TextWrapping="Wrap" Foreground="{StaticResource MutedText}" Margin="0,16,0,0"/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Отмена" IsCancel="True" MinWidth="96" Height="38" Margin="0,0,8,0"/>
            <Button Content="Сохранить" IsDefault="True" MinWidth="112" Height="38" Background="{StaticResource Accent}"
                    Foreground="#111318" FontWeight="SemiBold" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>