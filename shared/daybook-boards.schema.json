{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Daybook visual boards",
  "type": "object",
  "required": ["boards"],
  "properties": {
    "boards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "body": { "type": "string", "description": "Serialized board document" },
          "created": { "type": "integer" },
          "updated": { "type": "integer" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
